e="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=classic;endFill=1;startArrow=classic;startFill=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.3412;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="upinst" target="ep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b9" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1018" y="639" width="26" height="26" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=classic;endFill=1;exitX=0.8400;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="child" target="upami"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b10" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1087" y="385" width="26" height="26" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#E7157B;strokeWidth=2;endArrow=classic;endFill=1;startArrow=classic;startFill=1;dashed=1;exitX=1.0000;exitY=0.8400;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ssm" target="ep"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1265" y="340"/></Array></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=classic;endFill=1;exitX=0.2254;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s3box" target="ep_s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=classic;endFill=1;dashed=1;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.1760;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="iam" target="ssm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#5A6C86;strokeWidth=2;endArrow=classic;endFill=1;dashed=1;exitX=0.5000;exitY=1.9531;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="upinst" target="wsus"><mxGeometry relative="1" as="geometry"><mxPoint x="930" y="752" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="legL" value="&lt;b&gt;Flow&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;  The AWS Replication Agent replicates the source disks to the replication server in the staging area subnet over TCP 1500 (AWS Direct Connect or VPN).&lt;br&gt;&lt;b&gt;2&lt;/b&gt;  AWS MGN launches the test or cutover instance in a private target subnet.&lt;br&gt;&lt;b&gt;3&lt;/b&gt;  The post-launch action starts the parent runbook, which runs as the Automation role.&lt;br&gt;&lt;b&gt;4&lt;/b&gt;  The parent runbook starts the child runbook. For Windows Server 2008 R2 sources, the parent performs the first upgrade itself.&lt;br&gt;&lt;b&gt;5&lt;/b&gt;  The child runbook creates a pre-upgrade AMI of the launched instance. The launched instance isn&#x27;t changed.&lt;br&gt;&lt;b&gt;6&lt;/b&gt;  It launches a temporary upgrade instance from that AMI in the target subnet." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="985" width="830" height="200" as="geometry"/></mxCell><mxCell id="legR" value="&lt;br&gt;&lt;b&gt;7&lt;/b&gt;  It creates a volume from the Amazon-owned Windows Server installation media snapshot.&lt;br&gt;&lt;b&gt;8&lt;/b&gt;  It attaches the volume to the upgrade instance, and Windows Setup runs from it.&lt;br&gt;&lt;b&gt;9&lt;/b&gt;  Systems Manager reaches the upgrade instance through the VPC endpoints. After the upgrade, the AWS drivers come from Distributor, the optional Intel driver from your S3 bucket, and optional Windows updates from a WSUS server.&lt;br&gt;&lt;b&gt;10&lt;/b&gt;  The child runbook creates the upgraded AMI and terminates the upgrade instance.&lt;br&gt;&lt;b&gt;11&lt;/b&gt;  You launch the production server from the upgraded AMI. &lt;i&gt;(Not drawn.)&lt;/i&gt;&lt;br&gt;&lt;i&gt;Dashed lines show optional or management paths.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="870" y="985" width="840" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>